# Database — SQLite file for local/VPS hosting, or a Postgres URL (postgres://…) for managed hosting
DATABASE_URL=file:./data/nanopocket.db
# Long random strings
PAYLOAD_SECRET=change-me
PREVIEW_SECRET=change-me
# Public URL of the site (used for live preview, sitemap and social cards)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Optional: e-mail notifications for new pitches/enquiries
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=no-reply@nanopocketventures.com
NOTIFY_EMAIL=
